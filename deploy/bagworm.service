[Unit]
Description=Bagworm Census web app (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=bagworm
Group=bagworm
WorkingDirectory=/srv/bagworm/app
EnvironmentFile=/etc/bagworm/env
# One process on purpose (census queue lives in it) - see deploy/gunicorn.conf.py
ExecStart=/srv/bagworm/venv/bin/gunicorn -c deploy/gunicorn.conf.py app:app
Restart=always
RestartSec=5
# CPU inference uses all cores; keep the box responsive for web requests
Nice=5

[Install]
WantedBy=multi-user.target

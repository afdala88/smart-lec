# Copy to /etc/bagworm/env on the server (chmod 600) and load it from the systemd unit.
CLOUD_MODE=1
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ADMIN_PASSWORD=change-me
# Where browser uploads are stored, and how long they are kept after use
UPLOAD_DIR=/srv/bagworm/uploads
UPLOAD_RETENTION_DAYS=7
# Daily census.db backup copy (optional): gs:// bucket the VM may write to
BACKUP_BUCKET=
# WhatsApp agent (bagworm-agent) reachable from the server
BAGWORM_AGENT_URL=http://localhost:9556/bagworm-agent
BAGWORM_AGENT_BROADCAST_URL=http://localhost:9556/broadcast/census-result
